// apps/web/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================
enum PlaybookType {
  LOCAL_DOMINATION
  SAAS_AUTHORITY
  ECOM_SCALE
  AFFILIATE_FLIP
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  CLIENT_REVIEW
  APPROVED
  PAID
  ESCROW_RELEASED
  DISPUTED
}

enum ContentStatus {
  IDEA
  BRIEF_READY
  AI_DRAFT
  HUMAN_EDIT
  QA_PASSED
  APPROVED
  PUBLISHED
  INDEXED
}

enum LinkStatus {
  PROSPECTED
  OUTREACH_SENT
  NEGOTIATING
  PLACED
  LIVE
  REMOVED
}

enum PodRole {
  STRATEGIST
  CONTENT_SPECIALIST
  TECHNICAL_SEO
  LINK_BUILDER
}

enum InsuranceStatus {
  ACTIVE
  CLAIMED
  EXPIRED
  CANCELLED
}

enum ProjectStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  COMPLETED
  CHURNED
}

enum VerificationMethod {
  DATAFORSEO_RANK
  GSC_TRAFFIC
  GA4_CONVERSIONS
  MANUAL_REVIEW
  BACKLINK_COUNT
  INDEXATION_RATE
}

// ==================== CORE MODELS ====================

model User {
  id             String      @id @default(cuid())
  clerkId        String      @unique @map("clerk_id")
  email          String      @unique
  name           String?
  avatar         String?
  role           String      @default("CLIENT") // CLIENT, STRATEGIST, CONTENT_SPECIALIST, TECHNICAL_SEO, LINK_BUILDER, ADMIN
  organizationId String?     @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  podMemberships PodMember[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([organizationId])
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  clerkOrgId    String             @unique @map("clerk_org_id")
  plan          String             @default("FREE") // FREE, STARTER, GROWTH, SCALE, ENTERPRISE
  settings      Json               @default("{}")   // { brandVoice, integrations: {gsc, ga4, wp}, notifications }
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  users         User[]
  projects      Project[]
  pods          Pod[]
  playbooks     PlaybookInstance[]
  insurance     Insurance[]
  integrations  Integration[]

  @@map("organizations")
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       // GSC, GA4, WORDPRESS, GHOST, WEBFLOW, SEMRUSH, AHREFS
  config         Json         // { accessToken, refreshToken, siteUrl, propertyId, expiresAt }
  status         String       @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, ERROR
  lastSync       DateTime?    @map("last_sync")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, type])
  @@map("integrations")
}

model Pod {
  id             String       @id @default(cuid())
  name           String       // "Pod Alpha - Local SEO"
  niche          String[]     // ["dentist", "gym", "lawyer", "hvac"]
  capacity       Int          @default(4) // Max concurrent projects
  currentLoad    Int          @default(0)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        PodMember[]
  projects       Project[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("pods")
  @@index([organizationId])
}

model PodMember {
  id        String   @id @default(cuid())
  podId     String   @map("pod_id")
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PodRole  @default(CONTENT_SPECIALIST)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([podId, userId])
  @@map("pod_members")
}

model Project {
  id             String          @id @default(cuid())
  name           String
  status         ProjectStatus   @default(ONBOARDING)
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  podId          String?         @map("pod_id")
  pod            Pod?            @relation(fields: [podId], references: [id], onDelete: SetNull)
  playbookType   PlaybookType    @map("playbook_type")
  settings       Json            @default("{}")   // { targetUrls, competitors, niche }
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  milestones     Milestone[]
  contentItems   ContentItem[]
  backlinks      Backlink[]
  keywords       Keyword[]
  insuranceClaims InsuranceClaim[]

  @@map("projects")
  @@index([organizationId])
  @@index([podId])
}

model PlaybookInstance {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           PlaybookType
  config         Json         @default("{}")   // { targetKeywords, milestonesConfig }
  isActive       Boolean      @default(true)   @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("playbook_instances")
  @@index([organizationId])
}

model Milestone {
  id                 String             @id @default(cuid())
  projectId          String             @map("project_id")
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String
  targetValue        String             @map("target_value") // e.g. "Rank 1-3", "1000 visitors/mo"
  verificationMethod VerificationMethod @map("verification_method")
  status             MilestoneStatus    @default(PENDING)
  escrowAmount       Decimal            @map("escrow_amount") @db.Decimal(10, 2)
  escrowTxId         String?            @map("escrow_tx_id") // Razorpay/Stripe transfer or payment ID
  proofData          Json?              @map("proof_data")   // API verification proof (e.g. rank snapshot, GSC report)
  verifiedAt         DateTime?          @map("verified_at")
  releasedAt         DateTime?          @map("released_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("milestones")
  @@index([projectId])
}

model ContentItem {
  id             String        @id @default(cuid())
  projectId      String        @map("project_id")
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  status         ContentStatus @default(IDEA)
  keywordSeed    String?       @map("keyword_seed")
  briefData      Json?         @map("brief_data")    // Outline, keywords, references
  aiDraft        String?       @map("ai_draft")      @db.Text
  finalContent   String?       @map("final_content") @db.Text
  notionPageId   String?       @map("notion_page_id")
  publishedUrl   String?       @map("published_url")
  indexedAt      DateTime?     @map("indexed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@map("content_items")
  @@index([projectId])
}

model Backlink {
  id             String     @id @default(cuid())
  projectId      String     @map("project_id")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url            String     // URL where link is placed
  targetUrl      String     @map("target_url")
  domainAuthority Int        @map("domain_authority") // DR
  anchorText     String     @map("anchor_text")
  screenshotUrl  String?    @map("screenshot_url")
  status         LinkStatus @default(PROSPECTED)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("backlinks")
  @@index([projectId])
}

model Keyword {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text           String
  searchVolume   Int       @default(0) @map("search_volume")
  difficulty     Int       @default(0)
  currentRank    Int?      @map("current_rank")
  rankHistory    Json      @default("[]") // [{date: "2026-08-08", rank: 12}]
  lastSync       DateTime? @map("last_sync")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([projectId, text])
  @@map("keywords")
  @@index([projectId])
}

model Insurance {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         InsuranceStatus @default(ACTIVE)
  coverageAmount Decimal         @map("coverage_amount") @db.Decimal(10, 2)
  premiumAmount  Decimal         @map("premium_amount") @db.Decimal(10, 2)
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  claims         InsuranceClaim[]

  @@map("insurance")
  @@index([organizationId])
}

model InsuranceClaim {
  id           String   @id @default(cuid())
  insuranceId  String   @map("insurance_id")
  insurance    Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason       String   // e.g. "Traffic drop >15% due to algo update"
  trafficDrop  Float    @map("traffic_drop") // percentage
  status       String   @default("PENDING") // PENDING, INVESTIGATING, APPROVED, REJECTED
  actionTaken  String?  @map("action_taken") // e.g. "Assigned recovery pod"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("insurance_claims")
  @@index([insuranceId])
  @@index([projectId])
}
